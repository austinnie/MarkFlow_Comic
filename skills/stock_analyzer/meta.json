{
  "name": "股票分析助手",
  "description": "股票行情查询、技术指标分析、基本面分析、AI趋势预测、投资建议",
  "version": "1.0.0",
  "inputs": [
    {
      "name": "code",
      "type": "string",
      "required": true,
      "description": "股票代码 (如: 600036 或 sh600036)"
    },
    {
      "name": "market",
      "type": "string",
      "required": false,
      "description": "市场 (sh/sz/hk/us)",
      "default": "sh"
    },
    {
      "name": "days",
      "type": "integer",
      "required": false,
      "description": "历史数据天数",
      "default": 100
    },
    {
      "name": "model",
      "type": "string",
      "required": false,
      "description": "Ollama 模型",
      "default": "qwen2.5:7b"
    }
  ],
  "outputs": [
    {"name": "report_path", "description": "分析报告路径"},
    {"name": "stock_data", "description": "股票实时数据"},
    {"name": "analysis", "description": "AI 分析建议"},
    {"name": "chart_path", "description": "走势图路径"},
    {"name": "generated_at", "description": "生成时间"}
  ],
  "dependencies": [
    "requests",
    "pandas",
    "numpy",
    "matplotlib"
  ]
}