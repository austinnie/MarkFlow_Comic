{
  "name": "代码关系分析报告生成器",
  "description": "输入代码目录，自动生成代码结构分析报告，展示模块关系、函数调用链和架构概览",
  "version": "1.0.0",
  "inputs": [
    {
      "name": "code_path",
      "type": "string",
      "required": true,
      "description": "要分析的代码目录路径"
    },
    {
      "name": "output_format",
      "type": "string",
      "required": false,
      "description": "输出格式 (md/json)",
      "default": "md"
    },
    {
      "name": "max_depth",
      "type": "integer",
      "required": false,
      "description": "目录最大深度",
      "default": 5
    },
    {
      "name": "include_tests",
      "type": "boolean",
      "required": false,
      "description": "是否包含测试目录",
      "default": false
    }
  ],
  "outputs": [
    {"name": "report_path", "description": "报告文件路径"},
    {"name": "name", "description": "项目名称"},
    {"name": "total_files", "description": "总文件数"},
    {"name": "entry_points", "description": "入口文件列表"}
  ],
  "dependencies": []
}